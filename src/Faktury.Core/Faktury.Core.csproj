<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Faktury.Core – "serce" programu: model danych faktury, obliczenia VAT,
    walidacja NIP i numeracja. Celowo NIE zależy od żadnej biblioteki UI ani PDF,
    dzięki czemu tę samą logikę można użyć w aplikacji desktopowej (Avalonia),
    webowej (Blazor), konsolowej i w testach jednostkowych.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Faktury.Core</RootNamespace>
  </PropertyGroup>

</Project>
